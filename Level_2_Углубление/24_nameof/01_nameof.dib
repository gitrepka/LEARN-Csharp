## 2. nameof в ArgumentException и валидации

Самое частое применение nameof — в **исключениях** и **валидации параметров**:

```csharp
void SetAge(int age)
{
    if (age < 0)
        throw new ArgumentOutOfRangeException(nameof(age), "Возраст не может быть отрицательным");
    if (age > 150)
        throw new ArgumentOutOfRangeException(nameof(age), "Нереальный возраст");
}
```

При рефакторинге (переименование `age` → `years`) — nameof обновится автоматически.

Другие применения:
```csharp
// ArgumentNullException
void Process(string data)
{
    ArgumentNullException.ThrowIfNull(data, nameof(data));   // C# 10+
    // или:
    if (data == null) throw new ArgumentNullException(nameof(data));
}
```

#!csharp

// nameof в валидации
void SetName(string name)
{
    if (string.IsNullOrWhiteSpace(name))
        throw new ArgumentException("Имя не может быть пустым", nameof(name));
    Console.WriteLine($"Имя установлено: {name}");
}

void SetAge(int age)
{
    if (age < 0 || age > 150)
        throw new ArgumentOutOfRangeException(nameof(age), age, "Возраст от 0 до 150");
    Console.WriteLine($"Возраст установлен: {age}");
}

void Transfer(double amount, string fromAccount, string toAccount)
{
    if (amount <= 0)
        throw new ArgumentOutOfRangeException(nameof(amount), "Сумма должна быть положительной");
    if (fromAccount == null)
        throw new ArgumentNullException(nameof(fromAccount));
    if (toAccount == null)
        throw new ArgumentNullException(nameof(toAccount));

    Console.WriteLine($"Перевод {amount:C} с {fromAccount} на {toAccount}");
}

// Тестируем
SetName("Анна");
SetAge(25);
Transfer(1000, "ACC-001", "ACC-002");

try { SetAge(-5); }
catch (ArgumentOutOfRangeException ex)
{
    Console.WriteLine($"\nОшибка: {ex.Message}");
    Console.WriteLine($"Параметр: {ex.ParamName}");  // "age" — благодаря nameof
}

#!csharp

// nameof в классе — PropertyChanged (MVVM паттерн)
// Это частый паттерн в WPF/MAUI приложениях

class Person
{
    private string name = "";
    private int age;

    public string Name
    {
        get => name;
        set
        {
            if (name != value)
            {
                name = value;
                OnPropertyChanged(nameof(Name));   // "Name" — имя свойства
            }
        }
    }

    public int Age
    {
        get => age;
        set
        {
            if (age != value)
            {
                age = value;
                OnPropertyChanged(nameof(Age));    // "Age"
            }
        }
    }

    private void OnPropertyChanged(string propertyName)
    {
        Console.WriteLine($"Свойство изменено: {propertyName}");
    }
}

var p = new Person();
p.Name = "Анна";   // "Свойство изменено: Name"
p.Age = 25;         // "Свойство изменено: Age"

