## 3. Перегрузка конструкторов — несколько вариантов

Как и методы, конструкторы можно **перегружать** — создавать несколько с разными параметрами:

```csharp
class Dog
{
    public string Name;
    public int Age;

    public Dog()                        // без параметров
    {
        Name = "Без имени";
        Age = 0;
    }

    public Dog(string name)             // только имя
    {
        Name = name;
        Age = 0;
    }

    public Dog(string name, int age)    // имя + возраст
    {
        Name = name;
        Age = age;
    }
}

Dog d1 = new Dog();                 // "Без имени", 0
Dog d2 = new Dog("Бобик");         // "Бобик", 0
Dog d3 = new Dog("Рекс", 5);       // "Рекс", 5
```

#!csharp

class Rectangle
{
    public double Width { get; set; }
    public double Height { get; set; }

    // Конструктор 1: без параметров (единичный квадрат)
    public Rectangle()
    {
        Width = 1;
        Height = 1;
    }

    // Конструктор 2: квадрат (одна сторона)
    public Rectangle(double side)
    {
        Width = side;
        Height = side;
    }

    // Конструктор 3: прямоугольник
    public Rectangle(double width, double height)
    {
        Width = width;
        Height = height;
    }

    public double Area => Width * Height;

    public void Print()
    {
        Console.WriteLine($"  Прямоугольник {Width}x{Height}, площадь = {Area}");
    }
}

Console.WriteLine("Без параметров:");
new Rectangle().Print();

Console.WriteLine("Квадрат 5x5:");
new Rectangle(5).Print();

Console.WriteLine("Прямоугольник 3x7:");
new Rectangle(3, 7).Print();

