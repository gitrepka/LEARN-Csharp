## 2. Числовые значения enum

Каждый элемент enum — это **число**. По умолчанию: первый = 0, далее +1:

```csharp
enum Color { Red, Green, Blue }
// Red = 0, Green = 1, Blue = 2
```

Можно задать **явно**:

```csharp
enum HttpStatus
{
    OK = 200,
    NotFound = 404,
    ServerError = 500
}
```

Можно задать **базовый тип** (по умолчанию int):

```csharp
enum SmallEnum : byte { A, B, C }     // занимает 1 байт вместо 4
enum BigEnum : long { X = 1000000000 }
```

#!csharp

// Числовые значения по умолчанию
enum Priority { Low, Medium, High, Critical }
// Low=0, Medium=1, High=2, Critical=3

Console.WriteLine($"Low = {(int)Priority.Low}");           // 0
Console.WriteLine($"Medium = {(int)Priority.Medium}");     // 1
Console.WriteLine($"Critical = {(int)Priority.Critical}"); // 3

// Явные значения
enum HttpStatus
{
    OK = 200,
    Created = 201,
    BadRequest = 400,
    NotFound = 404,
    ServerError = 500
}

HttpStatus response = HttpStatus.OK;
Console.WriteLine($"\nHTTP {(int)response}: {response}");  // HTTP 200: OK

response = HttpStatus.NotFound;
Console.WriteLine($"HTTP {(int)response}: {response}");    // HTTP 404: NotFound

#!csharp

// Частично заданные значения
enum ErrorCode
{
    None = 0,
    Warning = 100,     // задано явно
    Error,             // = 101 (автоматически +1)
    Critical,          // = 102
    Fatal = 200,       // задано явно
    System             // = 201
}

Console.WriteLine($"None = {(int)ErrorCode.None}");         // 0
Console.WriteLine($"Warning = {(int)ErrorCode.Warning}");   // 100
Console.WriteLine($"Error = {(int)ErrorCode.Error}");       // 101
Console.WriteLine($"Critical = {(int)ErrorCode.Critical}"); // 102
Console.WriteLine($"Fatal = {(int)ErrorCode.Fatal}");       // 200
Console.WriteLine($"System = {(int)ErrorCode.System}");     // 201

