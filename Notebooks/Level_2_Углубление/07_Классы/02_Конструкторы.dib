### Что нового в этом уроке?
**Конструкторы** — специальные методы для создания объектов. Ключевое слово `this`.

#!markdown

## 1. Конструкторы

**Конструктор** — специальный метод, который вызывается при создании объекта (`new`). Позволяет задать начальные значения.

#!csharp

class Враг
{
    public string Имя { get; set; }
    public int Здоровье { get; set; }
    public int Урон { get; set; }

    // Конструктор — имя совпадает с именем класса, нет возвращаемого типа
    public Враг(string имя, int здоровье, int урон)
    {
        Имя = имя;
        Здоровье = здоровье;
        Урон = урон;
    }

    public void Показать()
    {
        Console.WriteLine($"Враг [{Имя}] HP:{Здоровье} ATK:{Урон}");
    }
}

// Создание с конструктором — сразу задаём значения
var гоблин = new Враг("Гоблин", 30, 5);
var дракон = new Враг("Дракон", 500, 50);

гоблин.Показать(); // Враг [Гоблин] HP:30 ATK:5
дракон.Показать(); // Враг [Дракон] HP:500 ATK:50

#!csharp

// Несколько конструкторов (перегрузка) + this

class Предмет
{
    public string Название { get; set; }
    public int Цена { get; set; }
    public string Редкость { get; set; }

    // Основной конструктор
    public Предмет(string название, int цена, string редкость)
    {
        Название = название;
        Цена = цена;
        Редкость = редкость;
    }

    // Упрощённый конструктор — вызывает основной через this(...)
    public Предмет(string название, int цена)
        : this(название, цена, "Обычный")
    {
    }

    // Конструктор по умолчанию
    public Предмет()
        : this("Неизвестно", 0, "Обычный")
    {
    }

    public override string ToString()
    {
        return $"{Название} ({Редкость}) — {Цена} золота";
    }
}

var меч = new Предмет("Меч огня", 500, "Редкий");
var щит = new Предмет("Деревянный щит", 50);    // редкость = "Обычный"
var что = new Предмет();                          // всё по умолчанию

Console.WriteLine(меч);  // Меч огня (Редкий) — 500 золота
Console.WriteLine(щит);  // Деревянный щит (Обычный) — 50 золота
Console.WriteLine(что);  // Неизвестно (Обычный) — 0 золота

