### Что нового в этом уроке?
**StringBuilder** — почему и когда использовать вместо `string`

#!markdown

## 1. StringBuilder — когда строки "тормозят"

**Проблема:** строки в C# **неизменяемые** (immutable). Каждая операция `+` создаёт **новую строку** в памяти. При множественной конкатенации — это медленно.

**Аналогия:** Обычная строка — это текст, высеченный на камне. Чтобы изменить слово, нужно высечь новый камень. `StringBuilder` — это доска, на которой можно стирать и дописывать.

#!csharp

using System.Diagnostics;

// Проблема: конкатенация строк в цикле — медленно
var sw = Stopwatch.StartNew();
string текст = "";
for (int i = 0; i < 50_000; i++)
{
    текст += "a"; // каждый раз создаётся НОВАЯ строка!
}
sw.Stop();
Console.WriteLine($"string + : {sw.ElapsedMilliseconds} мс, длина: {текст.Length}");

#!csharp

using System.Text;
using System.Diagnostics;

// Решение: StringBuilder — быстро!
var sw = Stopwatch.StartNew();
var sb = new StringBuilder();
for (int i = 0; i < 50_000; i++)
{
    sb.Append("a"); // изменяет один и тот же буфер
}
string результат = sb.ToString();
sw.Stop();
Console.WriteLine($"StringBuilder: {sw.ElapsedMilliseconds} мс, длина: {результат.Length}");

#!csharp

using System.Text;

// Основные методы StringBuilder
var sb = new StringBuilder();

sb.Append("Привет");              // добавить в конец
sb.Append(", ");
sb.Append("мир!");
Console.WriteLine(sb.ToString()); // Привет, мир!

sb.Insert(7, "прекрасный ");      // вставить по индексу
Console.WriteLine(sb.ToString()); // Привет, прекрасный мир!

sb.Replace("мир", "свет");       // заменить
Console.WriteLine(sb.ToString()); // Привет, прекрасный свет!

sb.Remove(0, 8);                 // удалить (индекс, длина)
Console.WriteLine(sb.ToString()); // прекрасный свет!

Console.WriteLine($"Длина: {sb.Length}");
Console.WriteLine($"Ёмкость: {sb.Capacity}"); // внутренний буфер

sb.Clear();                      // очистить
Console.WriteLine($"После Clear: '{sb}'");

#!csharp

using System.Text;

// Когда использовать StringBuilder:
// 1. Конкатенация в цикле
// 2. Построение HTML, SQL, JSON вручную
// 3. Любая ситуация, где строка строится по частям (>5-10 конкатенаций)

// Когда НЕ нужен:
// $"Привет, {имя}!" — обычная интерполяция, StringBuilder не нужен
// string.Join(", ", массив) — тоже эффективно

// Практический пример: генерация HTML-таблицы
string[] имена = { "Алиса", "Боб", "Чарли" };
int[] очки = { 95, 87, 92 };

var html = new StringBuilder();
html.AppendLine("<table>");
html.AppendLine("  <tr><th>Имя</th><th>Очки</th></tr>");

for (int i = 0; i < имена.Length; i++)
{
    html.AppendLine($"  <tr><td>{имена[i]}</td><td>{очки[i]}</td></tr>");
}

html.AppendLine("</table>");
Console.WriteLine(html.ToString());

