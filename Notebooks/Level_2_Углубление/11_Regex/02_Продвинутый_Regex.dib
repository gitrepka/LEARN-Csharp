# Продвинутый Regex — квантификаторы, классы, группы
> **Уровень:** 2 — Углубление | **Тема:** Regex (2/2)
> **Предыдущий:** [Основы Regex](./01_Основы_Regex.dib) | **Следующий:** [Level 3: Типы данных](../../Level_3_ООП/01_Типы_данных.dib)
---

### Что нового в этом уроке?
1. **Квантификаторы** — `*`, `+`, `?`, `{n}`, `{n,m}`
2. **Символьные классы** — `[a-z]`, `[0-9]`, `[^abc]`
3. **Группы** — `()`, именованные группы `(?<имя>...)`
4. **Практические примеры** — валидация email, парсинг логов, пароли, игровые команды

#!markdown

## 1. Квантификаторы — сколько раз повторяется

| Квантификатор | Значение |
|--------------|----------|
| `*` | 0 или более раз |
| `+` | 1 или более раз |
| `?` | 0 или 1 раз |
| `{n}` | Ровно n раз |
| `{n,}` | n или более раз |
| `{n,m}` | От n до m раз |

#!csharp

using System.Text.RegularExpressions;

// Примеры квантификаторов

// + : одна или более цифр
Console.WriteLine(Regex.Match("abc123def", @"\d+").Value);   // 123

// * : ноль или более
Console.WriteLine(Regex.Match("abc", @"\d*").Value);         // "" (пустая строка — 0 цифр)

// ? : 0 или 1
Console.WriteLine(Regex.IsMatch("color", @"colou?r"));       // True (u — 0 раз)
Console.WriteLine(Regex.IsMatch("colour", @"colou?r"));      // True (u — 1 раз)

// {n} : ровно n раз
Console.WriteLine(Regex.IsMatch("123", @"^\d{3}$"));         // True (ровно 3 цифры)
Console.WriteLine(Regex.IsMatch("1234", @"^\d{3}$"));        // False (4 цифры)

// {n,m} : от n до m
Console.WriteLine(Regex.IsMatch("12345", @"^\d{3,6}$"));     // True (5 цифр, 3-6 ок)

#!csharp

using System.Text.RegularExpressions;

// Якоря — начало и конец строки
// ^ — начало строки
// $ — конец строки

string[] тесты = { "123", "abc", "123abc", "abc123" };

foreach (var т in тесты)
{
    bool начинаетсяСЦифры = Regex.IsMatch(т, @"^\d");
    bool кончаетсяЦифрой = Regex.IsMatch(т, @"\d$");
    bool толькоЦифры = Regex.IsMatch(т, @"^\d+$");

    Console.WriteLine($"\"{т}\" — начало с цифры: {начинаетсяСЦифры}, конец цифрой: {кончаетсяЦифрой}, только цифры: {толькоЦифры}");
}

#!markdown

## 2. Символьные классы `[...]`

| Паттерн | Значение |
|---------|----------|
| `[abc]` | Один из: a, b или c |
| `[a-z]` | Любая строчная буква |
| `[A-Z]` | Любая заглавная буква |
| `[0-9]` | Любая цифра (= `\d`) |
| `[a-zA-Z]` | Любая буква |
| `[^abc]` | НЕ a, b, c |

#!csharp

using System.Text.RegularExpressions;

// Символьные классы
string текст = "Телефон: +7 (701) 234-56-78";

// Извлечь только цифры
string толькоЦифры = Regex.Replace(текст, @"[^0-9]", "");
Console.WriteLine($"Только цифры: {толькоЦифры}"); // 77012345678

// Найти содержимое в скобках
var вСкобках = Regex.Match(текст, @"\(([^)]+)\)");
Console.WriteLine($"В скобках: {вСкобках.Groups[1].Value}"); // 701

// Гласные и согласные
string слово = "Привет";
string гласные = Regex.Replace(слово, @"[^аеёиоуыэюяАЕЁИОУЫЭЮЯ]", "");
Console.WriteLine($"Гласные в \"{слово}\": {гласные}");

#!markdown

## 3. Группы `()` — захват частей совпадения

#!csharp

using System.Text.RegularExpressions;

// Группы () — захват частей совпадения

string дата = "Сегодня 15.03.2025, завтра 16.03.2025";

// Паттерн с группами: (день).(месяц).(год)
var совпадения = Regex.Matches(дата, @"(\d{2})\.(\d{2})\.(\d{4})");

foreach (Match м in совпадения)
{
    Console.WriteLine($"Полное:  {м.Value}");
    Console.WriteLine($"  День:  {м.Groups[1].Value}");
    Console.WriteLine($"  Месяц: {м.Groups[2].Value}");
    Console.WriteLine($"  Год:   {м.Groups[3].Value}");
    Console.WriteLine();
}

// Именованные группы (?<имя>...)
var м2 = Regex.Match("Цена: 1500 тенге", @"(?<число>\d+)\s+(?<валюта>\w+)");
Console.WriteLine($"Число: {м2.Groups["число"].Value}");   // 1500
Console.WriteLine($"Валюта: {м2.Groups["валюта"].Value}"); // тенге

#!markdown

## 4. Практические примеры

#!csharp

using System.Text.RegularExpressions;

// Пример 1: Валидация email (упрощённая)
bool ВалидныйEmail(string email)
{
    // Паттерн: буквы/цифры @ буквы . буквы(2-4)
    return Regex.IsMatch(email, @"^[\w.-]+@[\w.-]+\.\w{2,4}$");
}

string[] emails = {
    "test@mail.com",
    "user.name@company.co.kz",
    "invalid",
    "@missing.com",
    "no@dots",
    "good123@test.org"
};

foreach (var e in emails)
{
    Console.WriteLine($"  {e,-30} — {(ВалидныйEmail(e) ? "OK" : "НЕВЕРНО")}");
}

#!csharp

using System.Text.RegularExpressions;

// Пример 2: Извлечение данных из текста
string лог = """
    [2025-01-15 10:30:15] INFO: Сервер запущен на порте 8080
    [2025-01-15 10:30:20] WARNING: Мало памяти (512MB)
    [2025-01-15 10:31:05] ERROR: Файл не найден: /data/config.json
    [2025-01-15 10:32:00] INFO: Подключился пользователь id=42
    """;

// Извлекаем все записи: дата, уровень, сообщение
var паттерн = @"\[(?<дата>\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})\]\s(?<уровень>\w+):\s(?<сообщение>.+)";
var записи = Regex.Matches(лог, паттерн);

Console.WriteLine("Разобранный лог:");
foreach (Match з in записи)
{
    string уровень = з.Groups["уровень"].Value;
    string маркер = уровень switch
    {
        "ERROR" => "[!]",
        "WARNING" => "[~]",
        _ => "[ ]"
    };
    Console.WriteLine($"  {маркер} {з.Groups["дата"].Value} | {уровень,-8} | {з.Groups["сообщение"].Value}");
}

#!csharp

using System.Text.RegularExpressions;

// Пример 3: Валидация пароля
bool НадёжныйПароль(string пароль)
{
    if (пароль.Length < 8) return false;

    bool естьЗаглавная = Regex.IsMatch(пароль, @"[A-ZА-Я]");
    bool естьСтрочная = Regex.IsMatch(пароль, @"[a-zа-я]");
    bool естьЦифра = Regex.IsMatch(пароль, @"\d");
    bool естьСпецсимвол = Regex.IsMatch(пароль, @"[!@#$%^&*()_+\-=]");

    return естьЗаглавная && естьСтрочная && естьЦифра && естьСпецсимвол;
}

string[] пароли = { "12345678", "password", "Pass123!", "Str0ng!Pass", "Кр" };

Console.WriteLine("Проверка паролей:");
foreach (var п in пароли)
{
    Console.WriteLine($"  \"{п}\" — {(НадёжныйПароль(п) ? "НАДЁЖНЫЙ" : "СЛАБЫЙ")}");
}

#!csharp

using System.Text.RegularExpressions;

// Пример 4: Парсинг игровых команд
// В игре игрок вводит: "/give sword 5" или "/tp 100 200"

string[] команды = {
    "/give sword 5",
    "/tp 100 200",
    "/say Привет всем!",
    "/hp",
    "просто текст"
};

foreach (var cmd in команды)
{
    var м = Regex.Match(cmd, @"^/(\w+)\s*(.*)$");
    if (м.Success)
    {
        string команда = м.Groups[1].Value;
        string аргументы = м.Groups[2].Value;
        Console.WriteLine($"Команда: {команда,-8} Аргументы: [{аргументы}]");
    }
    else
    {
        Console.WriteLine($"Не команда: \"{cmd}\"");
    }
}

