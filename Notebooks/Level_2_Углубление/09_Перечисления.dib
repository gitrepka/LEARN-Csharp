# 09. Перечисления — enum (NEW TOPIC)
## Уровень 2 | LEARN C#

---

### Что ты уже знаешь (Level 1)
- Базовые типы данных (int, string, bool)
- Условия (if, switch)
- Классы и структуры

---

### Что нового?
1. **Что такое `enum`** — именованные константы
2. **Базовый тип и числовые значения**
3. **`[Flags]`** — перечисления как набор флагов
4. **Методы для enum** — Parse, TryParse, GetValues, HasFlag
5. **Практические примеры** — состояния игры, разрешения, дни недели

**В Godot:** `Key`, `MouseButton`, `Error` — это enum'ы.
**В Uno:** `Orientation`, `Visibility`, `HorizontalAlignment` — тоже.

#!markdown

## 1. Что такое `enum`

**Аналогия:** Светофор. У него три состояния: Красный, Жёлтый, Зелёный. Не 4, не 2 — ровно 3. Enum — это ограниченный набор значений с понятными именами.

**Зачем?** Вместо "магических чисел" (1, 2, 3) используем понятные имена.

#!csharp

// БЕЗ enum — "магические числа"
int состояние = 1;  // Что значит 1? Кто помнит?
if (состояние == 1)
    Console.WriteLine("Ожидание");
else if (состояние == 2)
    Console.WriteLine("В бою");

// Через месяц: 1 — это ожидание или начало? Непонятно!

#!csharp

// С enum — ясно и надёжно!
enum СостояниеИгры
{
    Меню,
    Загрузка,
    Игра,
    Пауза,
    ИграОкончена
}

СостояниеИгры текущее = СостояниеИгры.Игра;
Console.WriteLine($"Состояние: {текущее}"); // Игра

// Switch идеально работает с enum
string действие = текущее switch
{
    СостояниеИгры.Меню         => "Показать главное меню",
    СостояниеИгры.Загрузка     => "Показать прогресс-бар",
    СостояниеИгры.Игра         => "Обновлять игровой мир",
    СостояниеИгры.Пауза        => "Остановить время",
    СостояниеИгры.ИграОкончена => "Показать результат",
    _ => "Неизвестно"
};

Console.WriteLine($"Действие: {действие}");

#!csharp

// Ещё примеры enum
enum НаправлениеДвижения
{
    Вверх,
    Вниз,
    Влево,
    Вправо
}

enum Времягода
{
    Весна,
    Лето,
    Осень,
    Зима
}

enum Размер
{
    Маленький,
    Средний,
    Большой,
    Огромный
}

var направление = НаправлениеДвижения.Вправо;
var сезон = Времягода.Лето;
var размер = Размер.Средний;

Console.WriteLine($"Направление: {направление}");
Console.WriteLine($"Сезон: {сезон}");
Console.WriteLine($"Размер: {размер}");

#!markdown

## 2. Базовый тип и числовые значения

Каждое значение enum — это **число** под капотом. По умолчанию: первое = 0, второе = 1, и так далее.

#!csharp

enum Приоритет
{
    Низкий,     // = 0 (по умолчанию)
    Средний,    // = 1
    Высокий,    // = 2
    Критический // = 3
}

Приоритет п = Приоритет.Высокий;
Console.WriteLine($"Приоритет: {п}");         // Высокий
Console.WriteLine($"Числовое значение: {(int)п}"); // 2

// Можно задать значения вручную
enum КодОшибки
{
    Успех = 0,
    НеНайден = 404,
    Запрещено = 403,
    ОшибкаСервера = 500
}

КодОшибки код = КодОшибки.НеНайден;
Console.WriteLine($"Код: {(int)код} — {код}"); // 404 — НеНайден

// Преобразование числа в enum
КодОшибки изЧисла = (КодОшибки)500;
Console.WriteLine($"Из числа 500: {изЧисла}"); // ОшибкаСервера

#!csharp

// Базовый тип — по умолчанию int, но можно изменить
enum МаленькоеПеречисление : byte  // byte: 0-255
{
    Первый = 1,
    Второй = 2,
    Третий = 3
}

enum БольшоеПеречисление : long
{
    Маленькое = 1,
    Большое = 1_000_000_000L,
    ОченьБольшое = 9_000_000_000L
}

Console.WriteLine($"byte enum: {sizeof(byte)} байт");
Console.WriteLine($"Значение: {(byte)МаленькоеПеречисление.Второй}");
Console.WriteLine($"long enum: {(long)БольшоеПеречисление.ОченьБольшое}");

#!markdown

## 3. `[Flags]` — перечисления как набор флагов

**Зачем?** Иногда значения можно **комбинировать**. Например, разрешения: чтение + запись. Или свойства: жирный + курсив.

**Правило:** значения должны быть степенями двойки (1, 2, 4, 8, 16...).

#!csharp

[Flags]
enum Разрешения
{
    Нет        = 0,        // 0000
    Чтение     = 1,        // 0001
    Запись     = 2,        // 0010
    Выполнение = 4,        // 0100
    Удаление   = 8,        // 1000
    ПолныйДоступ = Чтение | Запись | Выполнение | Удаление // 1111 = 15
}

// Комбинируем флаги через |
Разрешения пользователь = Разрешения.Чтение | Разрешения.Запись;
Console.WriteLine($"Права: {пользователь}");        // Чтение, Запись
Console.WriteLine($"Числовое: {(int)пользователь}"); // 3

Разрешения админ = Разрешения.ПолныйДоступ;
Console.WriteLine($"Админ: {админ}"); // Чтение, Запись, Выполнение, Удаление

#!csharp

[Flags]
enum Разрешения
{
    Нет        = 0,
    Чтение     = 1,
    Запись     = 2,
    Выполнение = 4,
    Удаление   = 8,
    ПолныйДоступ = Чтение | Запись | Выполнение | Удаление
}

Разрешения права = Разрешения.Чтение | Разрешения.Запись;

// Проверка через HasFlag
Console.WriteLine($"Может читать:    {права.HasFlag(Разрешения.Чтение)}");     // True
Console.WriteLine($"Может удалять:   {права.HasFlag(Разрешения.Удаление)}");   // False
Console.WriteLine($"Может выполнять: {права.HasFlag(Разрешения.Выполнение)}"); // False

// Добавить право
права |= Разрешения.Выполнение;
Console.WriteLine($"\nПосле добавления выполнения: {права}");
Console.WriteLine($"Может выполнять: {права.HasFlag(Разрешения.Выполнение)}"); // True

// Убрать право
права &= ~Разрешения.Запись;
Console.WriteLine($"\nПосле удаления записи: {права}");
Console.WriteLine($"Может писать: {права.HasFlag(Разрешения.Запись)}"); // False

#!csharp

// Практический пример: стиль текста
[Flags]
enum СтильТекста
{
    Обычный      = 0,
    Жирный       = 1,
    Курсив       = 2,
    Подчёркнутый = 4,
    Зачёркнутый  = 8
}

СтильТекста заголовок = СтильТекста.Жирный | СтильТекста.Подчёркнутый;
Console.WriteLine($"Стиль заголовка: {заголовок}"); // Жирный, Подчёркнутый

СтильТекста примечание = СтильТекста.Курсив;
Console.WriteLine($"Стиль примечания: {примечание}"); // Курсив

#!markdown

## 4. Методы для работы с enum

#!csharp

enum ДеньНедели
{
    Понедельник = 1,
    Вторник,
    Среда,
    Четверг,
    Пятница,
    Суббота,
    Воскресенье
}

// Enum.GetValues — получить все значения
Console.WriteLine("Все дни недели:");
foreach (ДеньНедели день in Enum.GetValues(typeof(ДеньНедели)))
{
    Console.WriteLine($"  {день} = {(int)день}");
}

// Enum.GetNames — получить все имена
Console.WriteLine("\nИмена:");
foreach (string имя in Enum.GetNames(typeof(ДеньНедели)))
{
    Console.WriteLine($"  {имя}");
}

#!csharp

enum ДеньНедели
{
    Понедельник = 1,
    Вторник,
    Среда,
    Четверг,
    Пятница,
    Суббота,
    Воскресенье
}

// Enum.Parse — из строки в enum
string ввод = "Среда";
ДеньНедели день = (ДеньНедели)Enum.Parse(typeof(ДеньНедели), ввод);
Console.WriteLine($"Parsed: {день}"); // Среда

// Enum.TryParse — безопасная версия
string безопасный = "Суббота";
if (Enum.TryParse<ДеньНедели>(безопасный, out ДеньНедели результат))
    Console.WriteLine($"TryParse: {результат}"); // Суббота
else
    Console.WriteLine("Не удалось распознать");

// С игнорированием регистра
if (Enum.TryParse<ДеньНедели>("понедельник", ignoreCase: true, out var д))
    Console.WriteLine($"Ignore case: {д}"); // Понедельник

// Неправильная строка
if (!Enum.TryParse<ДеньНедели>("ЛунныйДень", out _))
    Console.WriteLine("'ЛунныйДень' — не день недели!");

// Enum.IsDefined — проверка, существует ли значение
Console.WriteLine($"Существует 3? {Enum.IsDefined(typeof(ДеньНедели), 3)}");   // True (Среда)
Console.WriteLine($"Существует 99? {Enum.IsDefined(typeof(ДеньНедели), 99)}"); // False

#!markdown

## 5. Практические примеры

#!csharp

// Пример 1: Состояния врага в игре
enum СостояниеВрага
{
    Патруль,
    Преследование,
    Атака,
    Отступление,
    Смерть
}

class Враг
{
    public string Имя { get; set; }
    public int Здоровье { get; set; }
    public СостояниеВрага Состояние { get; private set; }

    public Враг(string имя, int здоровье)
    {
        Имя = имя;
        Здоровье = здоровье;
        Состояние = СостояниеВрага.Патруль;
    }

    public void ОбновитьСостояние(int расстояниеДоИгрока)
    {
        Состояние = (Здоровье, расстояниеДоИгрока) switch
        {
            ( <= 0, _)     => СостояниеВрага.Смерть,
            ( < 20, _)     => СостояниеВрага.Отступление,
            (_, < 5)       => СостояниеВрага.Атака,
            (_, < 20)      => СостояниеВрага.Преследование,
            _              => СостояниеВрага.Патруль
        };
    }

    public override string ToString() =>
        $"{Имя} [HP:{Здоровье}] — {Состояние}";
}

var гоблин = new Враг("Гоблин", 50);
Console.WriteLine(гоблин);

гоблин.ОбновитьСостояние(15);  // расстояние 15
Console.WriteLine(гоблин);      // Преследование

гоблин.ОбновитьСостояние(3);   // расстояние 3
Console.WriteLine(гоблин);      // Атака

гоблин.Здоровье = 10;
гоблин.ОбновитьСостояние(3);
Console.WriteLine(гоблин);      // Отступление

#!csharp

// Пример 2: Система команд в консольной игре
enum Команда
{
    Неизвестно,
    Атака,
    Защита,
    Магия,
    Бег,
    Инвентарь
}

Команда РаспознатьКоманду(string ввод)
{
    string чистый = ввод.Trim().ToLower();

    return чистый switch
    {
        "атака" or "attack" or "а" => Команда.Атака,
        "защита" or "defend" or "з" => Команда.Защита,
        "магия" or "magic" or "м" => Команда.Магия,
        "бег" or "run" or "б" => Команда.Бег,
        "инвентарь" or "inv" or "и" => Команда.Инвентарь,
        _ => Команда.Неизвестно
    };
}

string[] тесты = { "Атака", "  защита  ", "м", "run", "танцевать" };
foreach (var тест in тесты)
{
    var команда = РаспознатьКоманду(тест);
    Console.WriteLine($"\"{тест}\" → {команда}");
}

