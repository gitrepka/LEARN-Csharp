## 2. Событие с кастомным делегатом (Action)

#!csharp

// Пример: система достижений через события
public class AchievementSystem
{
    // Событие с кастомным делегатом
    public event Action<string, string> AchievementUnlocked; // имя, описание

    private readonly HashSet<string> _unlocked = new();

    public void CheckAndUnlock(string id, string description, bool condition)
    {
        if (condition && _unlocked.Add(id))
        {
            AchievementUnlocked?.Invoke(id, description);
        }
    }

    public int TotalUnlocked => _unlocked.Count;
}

var achievements = new AchievementSystem();

// Подписчики
achievements.AchievementUnlocked += (name, desc) =>
    Console.WriteLine($"Достижение: {name} — {desc}");

achievements.AchievementUnlocked += (name, desc) =>
    Console.WriteLine($"   (Всего: {achievements.TotalUnlocked})");

// Проверяем достижения
achievements.CheckAndUnlock("first_kill", "Первая победа", true);
achievements.CheckAndUnlock("speedrun", "Пройти уровень за 60 секунд", true);
achievements.CheckAndUnlock("first_kill", "Первая победа", true); // Повторно — не сработает

#!markdown

