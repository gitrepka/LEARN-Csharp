# События (Events) — безопасные делегаты
> **Уровень:** 4 — Продвинутый | **Тема:** Методы (3/3)
> **Предыдущий:** [Лямбды](02_Лямбды.dib) | **Следующий:** [Продвинутые коллекции](../04_Коллекции/01_Продвинутые_коллекции.dib)
---

## Что ты уже знаешь
- Делегаты, multicast-делегаты
- Лямбда-выражения и замыкания
- Action, Func, Predicate

Теперь ты узнаешь про **события** — безопасную обёртку над делегатами.

---

## Зачем это нужно?

Событие — это **безопасный делегат**. Разница:
- Делегат можно вызвать извне: `myDelegate("hack")`
- Событие можно вызвать **только изнутри класса**, который его объявил

**Аналогия:** Делегат — это мегафон, который может взять любой. Событие — это мегафон, прикованный к трибуне: слушать могут все, а говорить — только владелец.

---

## 1. Стандартный паттерн событий .NET

#!csharp

// Стандартный паттерн событий .NET
public class Player
{
    public string Name { get; }
    private int _health;

    public int Health
    {
        get => _health;
        private set
        {
            int oldHealth = _health;
            _health = Math.Max(0, value);

            // Вызываем событие при изменении здоровья
            HealthChanged?.Invoke(this, new HealthChangedArgs(oldHealth, _health));

            if (_health == 0)
                Died?.Invoke(this, EventArgs.Empty);
        }
    }

    // Событие с кастомными аргументами
    public event EventHandler<HealthChangedArgs> HealthChanged;

    // Событие без дополнительных данных
    public event EventHandler Died;

    public Player(string name, int health)
    {
        Name = name;
        _health = health;
    }

    public void TakeDamage(int amount)
    {
        Console.WriteLine($"\n{Name} получает {amount} урона!");
        Health -= amount;
    }

    public void Heal(int amount)
    {
        Console.WriteLine($"\n{Name} лечится на {amount}!");
        Health += amount;
    }
}

// Кастомные аргументы события
public class HealthChangedArgs : EventArgs
{
    public int OldHealth { get; }
    public int NewHealth { get; }
    public int Delta => NewHealth - OldHealth;

    public HealthChangedArgs(int oldHealth, int newHealth)
    {
        OldHealth = oldHealth;
        NewHealth = newHealth;
    }
}

// --- Использование ---
var player = new Player("Герой", 100);

// Подписываемся на событие (+=)
player.HealthChanged += (sender, args) =>
{
    var p = (Player)sender;
    string direction = args.Delta > 0 ? "+" : "";
    Console.WriteLine($"  [UI] Здоровье {p.Name}: {args.OldHealth} -> {args.NewHealth} ({direction}{args.Delta})");
};

player.HealthChanged += (sender, args) =>
{
    if (args.NewHealth < 30)
        Console.WriteLine("  [ALERT] Здоровье критически низкое!");
};

player.Died += (sender, e) =>
{
    var p = (Player)sender;
    Console.WriteLine($"  [GAME OVER] {p.Name} погиб!");
};

// player.HealthChanged("hack"); // Ошибка! Событие нельзя вызвать извне

player.TakeDamage(30);
player.TakeDamage(50);
player.Heal(10);
player.TakeDamage(40);

