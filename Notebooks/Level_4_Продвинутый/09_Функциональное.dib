## 2. Функции, возвращающие функции

**Фабрика функций** — мощный паттерн. Создаём настроенные функции "на лету".

#!csharp

// --- Функция, возвращающая функцию ---

// Фабрика валидаторов
static Func<string, bool> CreateLengthValidator(int min, int max)
{
    return input => input != null && input.Length >= min && input.Length <= max;
}

static Func<int, bool> CreateRangeChecker(int min, int max)
{
    return value => value >= min && value <= max;
}

// Создаём настроенные валидаторы
var usernameValidator = CreateLengthValidator(3, 20);
var passwordValidator = CreateLengthValidator(8, 128);
var ageChecker = CreateRangeChecker(18, 120);

Console.WriteLine($"Username 'ab': {usernameValidator("ab")}");        // false (слишком короткий)
Console.WriteLine($"Username 'alice': {usernameValidator("alice")}");  // true
Console.WriteLine($"Password '123': {passwordValidator("123")}");      // false
Console.WriteLine($"Password '12345678': {passwordValidator("12345678")}"); // true
Console.WriteLine($"Age 15: {ageChecker(15)}");  // false
Console.WriteLine($"Age 25: {ageChecker(25)}");  // true

#!csharp

// Фабрика обработчиков — pipeline builder
static Func<T, T> Compose<T>(params Func<T, T>[] functions)
{
    return input =>
    {
        var result = input;
        foreach (var fn in functions)
            result = fn(result);
        return result;
    };
}

// Создаём pipeline обработки текста
var textProcessor = Compose<string>(
    s => s.Trim(),
    s => s.ToLower(),
    s => s.Replace("  ", " "),
    s => char.ToUpper(s[0]) + s[1..]  // Capitalize
);

Console.WriteLine(textProcessor("  HELLO   WORLD  "));  // "Hello world"
Console.WriteLine(textProcessor("  ПрИвЕт   МиР  "));  // "Привет мир"

// Фабрика форматирования чисел
static Func<double, string> CreateFormatter(string prefix, string suffix, int decimals)
{
    return value => $"{prefix}{value.ToString($"F{decimals}")}{suffix}";
}

var formatCurrency = CreateFormatter("$", "", 2);
var formatPercent = CreateFormatter("", "%", 1);
var formatTemp = CreateFormatter("", "°C", 1);

Console.WriteLine(formatCurrency(1234.5));   // $1234.50
Console.WriteLine(formatPercent(85.7));      // 85.7%
Console.WriteLine(formatTemp(36.6));         // 36.6°C

#!markdown

## 3. Замыкания (Closures) — глубокое понимание

Замыкание — когда функция "запоминает" переменные из окружения, где была создана. Это позволяет создавать **функции с состоянием**.

#!csharp

// Счётчик через замыкание — функция с внутренним состоянием
static Func<int> CreateCounter(int start = 0)
{
    int count = start; // Эта переменная "замкнута"
    return () => count++; // Каждый вызов увеличивает count
}

var counter = CreateCounter(1);
Console.WriteLine(counter()); // 1
Console.WriteLine(counter()); // 2
Console.WriteLine(counter()); // 3

// Каждый CreateCounter создаёт СВОЁ замыкание
var counterA = CreateCounter(100);
var counterB = CreateCounter(200);
Console.WriteLine($"A: {counterA()}, B: {counterB()}, A: {counterA()}, B: {counterB()}");
// A: 100, B: 200, A: 101, B: 201

#!csharp

// Мемоизация — кэширование результатов чистых функций
static Func<TArg, TResult> Memoize<TArg, TResult>(Func<TArg, TResult> func)
    where TArg : notnull
{
    var cache = new Dictionary<TArg, TResult>(); // Замкнутый кэш
    return arg =>
    {
        if (cache.TryGetValue(arg, out var cached))
        {
            Console.WriteLine($"  [Кэш] {arg}");
            return cached;
        }
        Console.WriteLine($"  [Вычисление] {arg}");
        var result = func(arg);
        cache[arg] = result;
        return result;
    };
}

// "Тяжёлое" вычисление
static long Fibonacci(int n) => n <= 1 ? n : Fibonacci(n - 1) + Fibonacci(n - 2);

// Обёрнутая в мемоизацию
var memoFib = Memoize<int, long>(n =>
{
    // Простая реализация для демонстрации
    if (n <= 1) return n;
    long a = 0, b = 1;
    for (int i = 2; i <= n; i++) { long t = a + b; a = b; b = t; }
    return b;
});

Console.WriteLine($"fib(10) = {memoFib(10)}"); // Вычисление
Console.WriteLine($"fib(10) = {memoFib(10)}"); // Кэш!
Console.WriteLine($"fib(20) = {memoFib(20)}"); // Вычисление
Console.WriteLine($"fib(20) = {memoFib(20)}"); // Кэш!

#!csharp

// Rate limiter через замыкание
static Func<bool> CreateRateLimiter(int maxCalls, TimeSpan window)
{
    var callTimes = new Queue<DateTime>();
    return () =>
    {
        var now = DateTime.Now;
        // Удаляем устаревшие вызовы
        while (callTimes.Count > 0 && now - callTimes.Peek() > window)
            callTimes.Dequeue();

        if (callTimes.Count >= maxCalls)
            return false; // Лимит превышен

        callTimes.Enqueue(now);
        return true; // OK
    };
}

// Максимум 3 вызова в секунду
var limiter = CreateRateLimiter(3, TimeSpan.FromSeconds(1));
for (int i = 1; i <= 5; i++)
{
    bool allowed = limiter();
    Console.WriteLine($"Вызов #{i}: {(allowed ? "Разрешён" : "ЗАБЛОКИРОВАН")}");
}

#!markdown

## 4. Каррирование (Currying)

**Каррирование** — превращение функции с N аргументами в цепочку функций с 1 аргументом.

`f(a, b, c)` -> `f(a)(b)(c)`

**Зачем:** частичное применение — фиксируем часть аргументов, получаем новую функцию.

#!csharp

// Обычная функция с 3 параметрами
static double CalculatePrice(double basePrice, double taxRate, double discount)
{
    return basePrice * (1 + taxRate) * (1 - discount);
}

Console.WriteLine($"Обычный вызов: {CalculatePrice(100, 0.13, 0.10):F2}");

// Каррированная версия
static Func<double, Func<double, double>> CurriedPrice(double basePrice)
{
    return taxRate => discount => basePrice * (1 + taxRate) * (1 - discount);
}

// Фиксируем basePrice
var priceFor100 = CurriedPrice(100);

// Фиксируем taxRate (получаем функцию только от discount)
var russianPrice100 = priceFor100(0.13); // Российский НДС

Console.WriteLine($"100 руб + 13% НДС, скидка 10%: {russianPrice100(0.10):F2}");
Console.WriteLine($"100 руб + 13% НДС, скидка 20%: {russianPrice100(0.20):F2}");
Console.WriteLine($"100 руб + 13% НДС, без скидки: {russianPrice100(0.00):F2}");

#!csharp

// Универсальная каррирующая функция
static Func<T1, Func<T2, TResult>> Curry<T1, T2, TResult>(
    Func<T1, T2, TResult> func)
{
    return a => b => func(a, b);
}

static Func<T1, Func<T2, Func<T3, TResult>>> Curry<T1, T2, T3, TResult>(
    Func<T1, T2, T3, TResult> func)
{
    return a => b => c => func(a, b, c);
}

// Каррируем обычные функции
Func<string, string, string> greet = (greeting, name) => $"{greeting}, {name}!";
var curriedGreet = Curry(greet);

var sayHello = curriedGreet("Привет");    // Фиксируем приветствие
var sayBye = curriedGreet("Пока");

Console.WriteLine(sayHello("Артас"));     // Привет, Артас!
Console.WriteLine(sayHello("Джайна"));    // Привет, Джайна!
Console.WriteLine(sayBye("Тралл"));       // Пока, Тралл!

// Каррированное умножение
Func<int, int, int> multiply = (a, b) => a * b;
var curriedMul = Curry(multiply);
var double_it = curriedMul(2);   // Умножение на 2
var triple_it = curriedMul(3);   // Умножение на 3

var numbers = new[] { 1, 2, 3, 4, 5 };
Console.WriteLine($"x2: {string.Join(", ", numbers.Select(n => double_it(n)))}");
Console.WriteLine($"x3: {string.Join(", ", numbers.Select(n => triple_it(n)))}");

#!markdown

## 5. Partial Application — частичное применение

Похоже на каррирование, но фиксируем **любые** аргументы (не только первый).

#!csharp

// Частичное применение — фиксируем часть аргументов
static Func<T2, TResult> Partial<T1, T2, TResult>(
    Func<T1, T2, TResult> func, T1 arg1)
{
    return arg2 => func(arg1, arg2);
}

static Func<T2, T3, TResult> Partial<T1, T2, T3, TResult>(
    Func<T1, T2, T3, TResult> func, T1 arg1)
{
    return (arg2, arg3) => func(arg1, arg2, arg3);
}

// Пример: логирование с фиксированным уровнем
Func<string, string, string> formatLog =
    (level, message) => $"[{DateTime.Now:HH:mm:ss}] [{level}] {message}";

var logInfo = Partial(formatLog, "INFO");
var logError = Partial(formatLog, "ERROR");
var logDebug = Partial(formatLog, "DEBUG");

Console.WriteLine(logInfo("Приложение запущено"));
Console.WriteLine(logError("Соединение потеряно"));
Console.WriteLine(logDebug("Переменная x = 42"));

Console.WriteLine();

// Пример: математические функции с фиксированными параметрами
Func<double, double, double> power = Math.Pow;
var square = Partial(power, 2.0);  // Ой, аргументы наоборот!

// Лучше напрямую через лямбду:
Func<double, double> squareOf = x => Math.Pow(x, 2);
Func<double, double> cubeOf = x => Math.Pow(x, 3);

Console.WriteLine($"5^2 = {squareOf(5)}");
Console.WriteLine($"3^3 = {cubeOf(3)}");

#!markdown

## 6. Композиция функций и Pipe

#!csharp

// Композиция: f(g(x)) -> compose(f, g)(x)
static Func<T, TResult> Compose<T, TIntermediate, TResult>(
    Func<TIntermediate, TResult> f,
    Func<T, TIntermediate> g)
{
    return x => f(g(x));
}

// Pipe: x |> f |> g -> pipe(x, f, g)
static TResult Pipe<T, TResult>(T value, Func<T, TResult> func)
    => func(value);

// Extension method для pipe (делает код читаемым)
// К сожалению, в Polyglot Notebook extension methods ограничены,
// но покажу идею:

// Пример: обработка данных через композицию
Func<string, string> trim = s => s.Trim();
Func<string, string> toLower = s => s.ToLower();
Func<string, string[]> splitWords = s => s.Split(' ', StringSplitOptions.RemoveEmptyEntries);
Func<string[], int> countWords = arr => arr.Length;

// Композиция: считаем слова в грязной строке
var cleanAndSplit = Compose(splitWords, Compose(toLower, trim));
var countCleanWords = Compose(countWords, cleanAndSplit);

string input = "  Hello   WORLD  foo   BAR  ";
Console.WriteLine($"Вход: '{input}'");
Console.WriteLine($"Слов: {countCleanWords(input)}");
Console.WriteLine($"Слова: {string.Join(", ", cleanAndSplit(input))}");

#!csharp

// Практический пример: Pipeline обработки заказов
public record OrderItem(string Product, int Quantity, decimal UnitPrice);

// Каждый шаг pipeline — чистая функция
static List<OrderItem> RemoveZeroQuantity(List<OrderItem> items)
    => items.Where(i => i.Quantity > 0).ToList();

static List<OrderItem> ApplyBulkDiscount(List<OrderItem> items)
    => items.Select(i => i.Quantity >= 10
        ? i with { UnitPrice = i.UnitPrice * 0.9m }
        : i).ToList();

static decimal CalculateTotal(List<OrderItem> items)
    => items.Sum(i => i.Quantity * i.UnitPrice);

static decimal ApplyTax(decimal total)
    => total * 1.13m;

// Pipeline
var orderItems = new List<OrderItem>
{
    new("Ноутбук", 2, 50000m),
    new("Мышь", 15, 1500m),     // Скидка за опт!
    new("Кабель USB", 0, 300m), // Нулевое количество — отфильтруется
    new("Монитор", 1, 25000m),
};

Console.WriteLine("Заказ:");
foreach (var item in orderItems)
    Console.WriteLine($"  {item.Product}: {item.Quantity} x {item.UnitPrice:N0}");

// Применяем pipeline шаг за шагом
var cleaned = RemoveZeroQuantity(orderItems);
var discounted = ApplyBulkDiscount(cleaned);
var subtotal = CalculateTotal(discounted);
var total = ApplyTax(subtotal);

Console.WriteLine($"\nПосле фильтрации: {cleaned.Count} позиций");
Console.WriteLine($"После скидки за опт:");
foreach (var item in discounted)
    Console.WriteLine($"  {item.Product}: {item.Quantity} x {item.UnitPrice:N0}");
Console.WriteLine($"Подытог: {subtotal:N0}");
Console.WriteLine($"Итого (с НДС 13%): {total:N0}");

// Можно записать компактно через pipeline:
var totalPipe = ApplyTax(
    CalculateTotal(
        ApplyBulkDiscount(
            RemoveZeroQuantity(orderItems))));
Console.WriteLine($"\nPipeline одной строкой: {totalPipe:N0}");

#!csharp

// Бонус: Fluent API через extension-подобный подход
// (имитируем через статические методы)

public static class Pipeline
{
    // Имитация Pipe оператора
    public static TResult Then<T, TResult>(T value, Func<T, TResult> func)
        => func(value);
}

// Ещё пример: комбинирование ФП с LINQ
var data = Enumerable.Range(1, 100);

// Создаём набор переиспользуемых трансформаций
Func<IEnumerable<int>, IEnumerable<int>> onlyEven = nums => nums.Where(n => n % 2 == 0);
Func<IEnumerable<int>, IEnumerable<int>> onlyPositive = nums => nums.Where(n => n > 0);
Func<IEnumerable<int>, IEnumerable<int>> takeFirst10 = nums => nums.Take(10);
Func<IEnumerable<int>, IEnumerable<int>> sortDesc = nums => nums.OrderByDescending(n => n);

// Комбинируем трансформации
var pipeline = Compose(
    takeFirst10,
    Compose(sortDesc, onlyEven)
);

var result = pipeline(data);
Console.WriteLine($"Топ-10 чётных (убыв.): {string.Join(", ", result)}");

#!markdown

## 7. Сравнение: Императивный vs Функциональный стиль

#!csharp

// Задача: обработать список студентов

public record Student(string Name, int Age, double GPA, string Faculty);

var students = new List<Student>
{
    new("Алиса", 20, 4.8, "Информатика"),
    new("Борис", 22, 3.5, "Математика"),
    new("Вика", 19, 4.5, "Информатика"),
    new("Григорий", 21, 3.8, "Физика"),
    new("Дарья", 20, 4.9, "Информатика"),
    new("Евгений", 23, 3.2, "Математика"),
    new("Жанна", 21, 4.2, "Физика"),
};

// --- ИМПЕРАТИВНЫЙ СТИЛЬ ---
Console.WriteLine("=== Императивный стиль ===");
var itStudentsImperative = new List<Student>();
foreach (var s in students)
{
    if (s.Faculty == "Информатика" && s.GPA >= 4.5)
        itStudentsImperative.Add(s);
}
itStudentsImperative.Sort((a, b) => b.GPA.CompareTo(a.GPA));
foreach (var s in itStudentsImperative)
    Console.WriteLine($"  {s.Name}: GPA {s.GPA}");

// --- ФУНКЦИОНАЛЬНЫЙ СТИЛЬ ---
Console.WriteLine("\n=== Функциональный стиль ===");
students
    .Where(s => s.Faculty == "Информатика" && s.GPA >= 4.5)
    .OrderByDescending(s => s.GPA)
    .ToList()
    .ForEach(s => Console.WriteLine($"  {s.Name}: GPA {s.GPA}"));

// Функциональный стиль: короче, декларативнее, меньше шансов на баг.
// Мы описываем ЧТО хотим, а не КАК это сделать.

Console.WriteLine("\n=== Сложная агрегация (функциональный) ===");
var report = students
    .GroupBy(s => s.Faculty)
    .Select(g => new
    {
        Faculty = g.Key,
        Count = g.Count(),
        AvgGPA = g.Average(s => s.GPA),
        TopStudent = g.OrderByDescending(s => s.GPA).First().Name
    })
    .OrderByDescending(r => r.AvgGPA);

foreach (var r in report)
    Console.WriteLine($"  {r.Faculty}: {r.Count} чел., " +
                      $"Avg GPA: {r.AvgGPA:F2}, Лучший: {r.TopStudent}");

