## 2. Атрибуты: `[JsonPropertyName]`, `[JsonIgnore]`, `[JsonInclude]`

#!csharp

using System.Text.Json;
using System.Text.Json.Serialization;

public class PlayerProfile
{
    // Переименовать поле в JSON
    [JsonPropertyName("player_name")]
    public string Name { get; set; }

    [JsonPropertyName("xp")]
    public int ExperiencePoints { get; set; }

    // Не включать в JSON
    [JsonIgnore]
    public string PasswordHash { get; set; }

    // Не сериализовать если значение null
    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
    public string? Guild { get; set; }

    // Не сериализовать если значение по умолчанию (0 для int)
    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)]
    public int Deaths { get; set; }

    public DateTime LastLogin { get; set; }
}

var profile = new PlayerProfile
{
    Name = "Джайна",
    ExperiencePoints = 85000,
    PasswordHash = "secret123hash", // Не попадёт в JSON!
    Guild = null,                   // Не попадёт в JSON (null)
    Deaths = 0,                     // Не попадёт в JSON (default)
    LastLogin = DateTime.Now
};

var opts = new JsonSerializerOptions { WriteIndented = true };
string json = JsonSerializer.Serialize(profile, opts);
Console.WriteLine(json);

// Десериализация — пароль будет null (его нет в JSON)
var loaded = JsonSerializer.Deserialize<PlayerProfile>(json);
Console.WriteLine($"\nЗагружен: {loaded.Name}, XP: {loaded.ExperiencePoints}");
Console.WriteLine($"Пароль (должен быть null): {loaded.PasswordHash ?? "(null)"}");

