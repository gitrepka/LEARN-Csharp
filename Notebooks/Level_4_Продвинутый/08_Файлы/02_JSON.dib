## 4. Полный пример: система сохранения игры

#!csharp

using System.Text.Json;

// Полный пример: система сохранения игры
public class GameSave
{
    public string PlayerName { get; set; }
    public int Level { get; set; }
    public (double X, double Y) Position { get; set; }
    public Dictionary<string, int> Stats { get; set; } = new();
    public List<string> CompletedQuests { get; set; } = new();
    public DateTime SaveDate { get; set; }
}

// Сохранение
async Task SaveGame(GameSave save, string path)
{
    var options = new JsonSerializerOptions { WriteIndented = true };
    string json = JsonSerializer.Serialize(save, options);
    await File.WriteAllTextAsync(path, json);
    Console.WriteLine($"Игра сохранена в {Path.GetFileName(path)}");
}

// Загрузка
async Task<GameSave> LoadGame(string path)
{
    if (!File.Exists(path))
        throw new FileNotFoundException($"Файл сохранения не найден: {path}");

    string json = await File.ReadAllTextAsync(path);
    return JsonSerializer.Deserialize<GameSave>(json);
}

// Тест
string savePath = Path.Combine(Path.GetTempPath(), "save_01.json");

var save = new GameSave
{
    PlayerName = "Тралл",
    Level = 35,
    Position = (150.5, -30.2),
    Stats = new() { ["Сила"] = 80, ["Интеллект"] = 60, ["Ловкость"] = 45 },
    CompletedQuests = new() { "Начало пути", "Спасение деревни", "Древний артефакт" },
    SaveDate = DateTime.Now
};

await SaveGame(save, savePath);

var loaded = await LoadGame(savePath);
Console.WriteLine($"\nЗагружено: {loaded.PlayerName}, Ур.{loaded.Level}");
Console.WriteLine($"Позиция: ({loaded.Position.X}, {loaded.Position.Y})");
Console.WriteLine($"Квесты: {string.Join(", ", loaded.CompletedQuests)}");
Console.WriteLine($"Характеристики:");
foreach (var stat in loaded.Stats)
    Console.WriteLine($"  {stat.Key}: {stat.Value}");

