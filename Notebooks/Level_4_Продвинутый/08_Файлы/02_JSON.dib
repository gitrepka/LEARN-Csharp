## 3. Настройки сериализации

#!csharp

using System.Text.Json;
using System.Text.Json.Serialization;

// Глобальные настройки
var options = new JsonSerializerOptions
{
    WriteIndented = true,                    // Красивый вывод
    PropertyNamingPolicy = JsonNamingPolicy.CamelCase, // camelCase
    DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull, // Пропускать null
    PropertyNameCaseInsensitive = true,      // Игнорировать регистр при чтении
    Converters = { new JsonStringEnumConverter() } // Enum как строки
};

public enum Rarity { Common, Rare, Epic, Legendary }

public class Item
{
    public string Name { get; set; }
    public int Damage { get; set; }
    public Rarity Rarity { get; set; }
    public string? Description { get; set; }
}

var items = new List<Item>
{
    new() { Name = "Железный меч", Damage = 15, Rarity = Rarity.Common },
    new() { Name = "Ледяной посох", Damage = 45, Rarity = Rarity.Epic, Description = "Заморозка врагов" },
    new() { Name = "Фростморн", Damage = 100, Rarity = Rarity.Legendary },
};

string json = JsonSerializer.Serialize(items, options);
Console.WriteLine(json);

// Без JsonStringEnumConverter: "rarity": 3 (число)
// С JsonStringEnumConverter: "rarity": "Legendary" (строка) — читаемо!

