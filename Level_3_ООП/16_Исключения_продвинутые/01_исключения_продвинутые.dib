## 3. Кастомные исключения

Можно создавать **свои типы** исключений, наследуя от `Exception`:

```csharp
// Минимальный кастомный Exception
class InsufficientFundsException : Exception
{
    public decimal Balance { get; }
    public decimal Amount { get; }

    public InsufficientFundsException(decimal balance, decimal amount)
        : base($"Недостаточно средств. Баланс: {balance}, запрошено: {amount}")
    {
        Balance = balance;
        Amount = amount;
    }
}
```

**Рекомендации по кастомным исключениям:**
1. Наследуйся от `Exception` (не от `ApplicationException`)
2. Название заканчивается на `Exception`
3. Добавляй свойства с полезной информацией
4. Передавай `message` в базовый конструктор через `: base(message)`
5. В реальных проектах добавляй конструктор с `innerException`

**Когда создавать свой Exception:**
- Стандартные исключения **не описывают** вашу ситуацию
- Нужно передать **дополнительную информацию** (например, баланс, ID)
- Нужно ловить **именно вашу ошибку** отдельным catch

#!csharp

// Кастомное исключение
class InsufficientFundsException : Exception
{
    public decimal Balance { get; }
    public decimal Amount { get; }

    public InsufficientFundsException(decimal balance, decimal amount)
        : base($"Недостаточно средств. Баланс: {balance:F2}₽, запрошено: {amount:F2}₽")
    {
        Balance = balance;
        Amount = amount;
    }
}

class NegativeAmountException : Exception
{
    public NegativeAmountException(decimal amount)
        : base($"Сумма не может быть отрицательной: {amount:F2}₽") { }
}

// Использование
class BankAccount
{
    public string Owner { get; }
    public decimal Balance { get; private set; }

    public BankAccount(string owner, decimal balance)
    {
        Owner = owner;
        Balance = balance;
    }

    public void Withdraw(decimal amount)
    {
        if (amount <= 0)
            throw new NegativeAmountException(amount);
        if (amount > Balance)
            throw new InsufficientFundsException(Balance, amount);

        Balance -= amount;
        Console.WriteLine($"  Снято {amount:F2}₽. Остаток: {Balance:F2}₽");
    }
}

// Тестирование
BankAccount account = new BankAccount("Анна", 1000);
decimal[] amounts = { 300, -50, 500, 800 };

foreach (decimal amount in amounts)
{
    Console.WriteLine($"\nПопытка снять {amount:F2}₽:");
    try
    {
        account.Withdraw(amount);
    }
    catch (NegativeAmountException ex)
    {
        Console.WriteLine($"  ОШИБКА: {ex.Message}");
    }
    catch (InsufficientFundsException ex)
    {
        Console.WriteLine($"  ОШИБКА: {ex.Message}");
        Console.WriteLine($"  Не хватает: {ex.Amount - ex.Balance:F2}₽");
    }
}

