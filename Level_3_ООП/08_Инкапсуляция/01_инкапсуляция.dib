## 3. private set, init -- уровни доступа к сеттеру

В C# можно задать **разные** уровни доступа для get и set:

| Синтаксис | get (чтение) | set (запись) |
|---|---|---|
| `{ get; set; }` | Публичный | Публичный |
| `{ get; private set; }` | Публичный | Только внутри класса |
| `{ get; protected set; }` | Публичный | Класс + наследники |
| `{ get; init; }` | Публичный | Только при создании объекта |
| `{ get; }` | Публичный | Только в конструкторе |

#!csharp

public class User
{
    // Только через конструктор
    public int Id { get; }

    // init -- при создании объекта (конструктор или object initializer)
    public required string Name { get; init; }

    // private set -- только внутри класса
    public DateTime LastLogin { get; private set; }

    // Обычный set -- откуда угодно
    public string Status { get; set; } = "Offline";

    public User(int id)
    {
        Id = id;
        LastLogin = DateTime.Now;
    }

    public void Login()
    {
        LastLogin = DateTime.Now;  // OK -- private set доступен внутри класса
        Status = "Online";
    }
}

var user = new User(1) { Name = "Алиса" };
Console.WriteLine($"#{user.Id} {user.Name}, последний вход: {user.LastLogin:HH:mm:ss}");

// user.Id = 2;        // Ошибка! Только get
// user.Name = "Боб";  // Ошибка! init-only
// user.LastLogin = ...; // Ошибка! private set

user.Status = "Busy";   // OK -- обычный set
user.Login();            // LastLogin обновляется изнутри

Console.WriteLine($"Статус: {user.Status}, вход: {user.LastLogin:HH:mm:ss}");

