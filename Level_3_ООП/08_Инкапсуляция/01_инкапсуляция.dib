## 4. set vs private set vs init -- сравнение

```csharp
public class Demo
{
    public string A { get; set; }          // Свободная запись
    public string B { get; private set; }  // Запись только изнутри
    public string C { get; init; }         // Запись только при создании
    public string D { get; }               // Запись только в конструкторе
}
```

| Сценарий | `set` | `private set` | `init` | `get;` only |
|---|---|---|---|---|
| В конструкторе | + | + | + | + |
| В object initializer `new X { Prop = ... }` | + | - | + | - |
| В методе класса | + | + | - | - |
| Снаружи класса | + | - | - | - |

#!csharp

public class GameCharacter
{
    // get; -- только конструктор
    public string Name { get; }

    // init -- конструктор + object initializer
    public string Class { get; init; }

    // private set -- методы класса могут менять
    public int Level { get; private set; } = 1;
    public int Experience { get; private set; } = 0;
    public int Health { get; private set; }

    // set -- все могут менять
    public string Guild { get; set; } = "Без гильдии";

    public GameCharacter(string name, int maxHealth)
    {
        Name = name;
        Health = maxHealth;
    }

    public void GainXP(int xp)
    {
        Experience += xp;
        if (Experience >= Level * 100)
        {
            Experience -= Level * 100;
            Level++;
            Console.WriteLine($"{Name} повышен до уровня {Level}!");
        }
    }

    public void TakeDamage(int damage)
    {
        Health = Math.Max(0, Health - damage);
        if (Health == 0) Console.WriteLine($"{Name} побеждён!");
    }

    public override string ToString()
        => $"{Name} [{Class}] Ур.{Level} HP:{Health} XP:{Experience} ({Guild})";
}

var hero = new GameCharacter("Артас", 100) { Class = "Паладин" };  // init OK
Console.WriteLine(hero);

hero.Guild = "Альянс";    // set OK
hero.GainXP(150);         // private set -- изнутри OK
hero.TakeDamage(30);
Console.WriteLine(hero);

// hero.Name = "Другой";   // Ошибка! get; only
// hero.Class = "Маг";     // Ошибка! init -- только при создании
// hero.Level = 99;         // Ошибка! private set
// hero.Health = 999;       // Ошибка! private set

