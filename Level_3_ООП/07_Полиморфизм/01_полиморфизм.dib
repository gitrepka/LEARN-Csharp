## 6. is vs typeof vs GetType -- когда что использовать

| Ситуация | Что использовать |
|---|---|
| "Является ли объект типом X или его наследником?" | `is` |
| "Является ли объект **ТОЧНО** типом X?" | `GetType() == typeof(X)` |
| "Проверить тип и получить переменную" | `is X variable` |
| "Получить информацию о типе по имени" | `typeof(X)` |
| "Получить тип объекта во время выполнения" | `obj.GetType()` |
| "Безопасно привести к типу" | `is X variable` или `as X` |

#!csharp

public abstract class Notification
{
    public string Text { get; set; }
}
public class EmailNotification : Notification { public string To { get; set; } }
public class SmsNotification : Notification { public string Phone { get; set; } }
public class PushNotification : Notification { public string DeviceId { get; set; } }

Notification[] notifications = {
    new EmailNotification { Text = "Привет", To = "alice@mail.ru" },
    new SmsNotification { Text = "Код: 1234", Phone = "+7-999-000-00-00" },
    new PushNotification { Text = "Новое сообщение", DeviceId = "ABC123" },
    new EmailNotification { Text = "Отчёт", To = "boss@company.ru" },
};

// Использование switch с pattern matching (самый современный подход!)
foreach (var n in notifications)
{
    string info = n switch
    {
        EmailNotification e => $"Email -> {e.To}: {e.Text}",
        SmsNotification s   => $"SMS -> {s.Phone}: {s.Text}",
        PushNotification p  => $"Push -> {p.DeviceId}: {p.Text}",
        _                   => $"Неизвестный тип: {n.Text}",
    };
    Console.WriteLine(info);
}

// Статистика по типам
Console.WriteLine($"\nEmail: {notifications.Count(n => n is EmailNotification)}");
Console.WriteLine($"SMS:   {notifications.Count(n => n is SmsNotification)}");
Console.WriteLine($"Push:  {notifications.Count(n => n is PushNotification)}");

#!markdown

## 7. Полиморфизм в реальных сценариях

Полиморфизм -- это не просто "вызвать разные методы". Это **дизайн-паттерн**, позволяющий:
- Добавлять **новые типы без изменения** существующего кода
- Писать **универсальные алгоритмы** для разных типов
- Реализовать **принцип Open/Closed** (открыт для расширения, закрыт для изменения)

```csharp
// Добавить новую фигуру? Просто создай новый класс!
// Метод CalculateTotalArea() менять НЕ нужно!
double CalculateTotalArea(Shape[] shapes)
{
    return shapes.Sum(s => s.Area());
}
```

#!csharp

// Система обработки платежей -- реальный пример
public abstract class PaymentProcessor
{
    public abstract bool ProcessPayment(decimal amount);
    public abstract string ProviderName { get; }

    // Шаблонный метод -- общая логика
    public void HandlePayment(decimal amount, string description)
    {
        Console.WriteLine($"--- Оплата: {description} ---");
        Console.WriteLine($"Провайдер: {ProviderName}");
        Console.WriteLine($"Сумма: {amount:N2} руб.");

        bool success = ProcessPayment(amount);  // Полиморфный вызов!

        Console.WriteLine($"Результат: {(success ? "Успешно" : "Отказ")}");
        Console.WriteLine();
    }
}

public class CreditCardProcessor : PaymentProcessor
{
    public override string ProviderName => "Visa/MasterCard";
    public override bool ProcessPayment(decimal amount) => amount <= 500000;
}

public class CryptoProcessor : PaymentProcessor
{
    public override string ProviderName => "Bitcoin";
    public override bool ProcessPayment(decimal amount) => amount <= 1000000;
}

public class CashProcessor : PaymentProcessor
{
    public override string ProviderName => "Наличные";
    public override bool ProcessPayment(decimal amount) => amount <= 100000;
}

// Один метод работает с ЛЮБЫМ процессором -- полиморфизм!
PaymentProcessor[] processors = {
    new CreditCardProcessor(),
    new CryptoProcessor(),
    new CashProcessor(),
};

foreach (var processor in processors)
{
    processor.HandlePayment(50000, "Покупка ноутбука");
}

