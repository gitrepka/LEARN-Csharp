## 3. Проверка типа: is

Оператор **`is`** проверяет, является ли объект экземпляром указанного типа:

```csharp
Animal animal = new Dog();
if (animal is Dog)          // true -- animal на самом деле Dog
if (animal is Animal)       // true -- Dog IS-A Animal
if (animal is Cat)          // false -- Dog не является Cat
if (animal is object)       // true -- всё наследует от object
```

С C# 7+ можно **совместить проверку и приведение** (pattern matching):

```csharp
if (animal is Dog dog)
{
    // dog уже приведён к типу Dog!
    dog.Bark();
}
```

#!csharp

public abstract class Vehicle
{
    public string Name { get; set; }
    public abstract void Start();
}

public class Car : Vehicle
{
    public int Doors { get; set; }
    public override void Start() => Console.WriteLine($"{Name}: Врум-врум!");
}

public class Bicycle : Vehicle
{
    public bool HasGears { get; set; }
    public override void Start() => Console.WriteLine($"{Name}: Кручу педали!");
}

public class Boat : Vehicle
{
    public string FuelType { get; set; }
    public override void Start() => Console.WriteLine($"{Name}: Буль-буль!");
}

Vehicle[] vehicles = {
    new Car { Name = "Toyota", Doors = 4 },
    new Bicycle { Name = "Trek", HasGears = true },
    new Boat { Name = "Yamaha", FuelType = "Бензин" },
    new Car { Name = "Tesla", Doors = 4 },
};

foreach (var v in vehicles)
{
    v.Start();  // Полиморфный вызов

    // Проверка типа с pattern matching
    if (v is Car car)
        Console.WriteLine($"  Это машина с {car.Doors} дверьми");
    else if (v is Bicycle bike)
        Console.WriteLine($"  Это велосипед, передачи: {(bike.HasGears ? "да" : "нет")}");
    else if (v is Boat boat)
        Console.WriteLine($"  Это лодка, топливо: {boat.FuelType}");

    Console.WriteLine();
}

// Подсчёт по типам
int cars = vehicles.Count(v => v is Car);
int bikes = vehicles.Count(v => v is Bicycle);
Console.WriteLine($"Машин: {cars}, велосипедов: {bikes}");

