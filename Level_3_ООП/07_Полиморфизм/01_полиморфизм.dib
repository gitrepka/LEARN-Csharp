## 2. Переменная базового типа хранит потомка

Это **ключевое свойство** полиморфизма -- переменная типа базового класса может хранить объект **любого** производного класса:

```csharp
Animal pet = new Dog("Рекс");    // Dog IS-A Animal
Animal pet2 = new Cat("Мурка");  // Cat IS-A Animal
// Dog is not a Cat, нельзя: Cat cat = new Dog();
```

Это работает потому, что наследование -- это отношение **"является"** (IS-A):
- Собака **является** животным
- Круг **является** фигурой
- Каждый студент **является** человеком

#!csharp

public class Employee
{
    public string Name { get; set; }
    public virtual decimal CalculatePay() => 0;
}

public class FullTimeEmployee : Employee
{
    public decimal MonthlySalary { get; set; }
    public override decimal CalculatePay() => MonthlySalary;
}

public class Contractor : Employee
{
    public decimal HourlyRate { get; set; }
    public int HoursWorked { get; set; }
    public override decimal CalculatePay() => HourlyRate * HoursWorked;
}

public class Intern : Employee
{
    public decimal Stipend { get; set; }
    public override decimal CalculatePay() => Stipend;
}

// Все хранятся как Employee -- полиморфизм!
Employee[] staff = {
    new FullTimeEmployee { Name = "Алиса", MonthlySalary = 150000 },
    new Contractor { Name = "Боб", HourlyRate = 2000, HoursWorked = 80 },
    new Intern { Name = "Чарли", Stipend = 30000 },
    new FullTimeEmployee { Name = "Диана", MonthlySalary = 200000 },
};

// Единообразная обработка
decimal totalPayroll = 0;
foreach (Employee emp in staff)
{
    decimal pay = emp.CalculatePay();  // Полиморфный вызов
    Console.WriteLine($"{emp.Name}: {pay:N0} руб.");
    totalPayroll += pay;
}
Console.WriteLine($"\nОбщий ФОТ: {totalPayroll:N0} руб.");

