## 3. Расширения для коллекций

Все методы LINQ (`Where`, `Select`, `OrderBy` и т.д.) -- это **методы расширения** для `IEnumerable<T>`! Ты можешь создавать свои:

```csharp
public static class EnumerableExtensions
{
    public static void ForEach<T>(this IEnumerable<T> source, Action<T> action)
    {
        foreach (var item in source)
            action(item);
    }
}

// Использование
new[] { 1, 2, 3 }.ForEach(x => Console.WriteLine(x));
```

#!csharp

public static class CollectionExtensions
{
    // ForEach для любой коллекции
    public static void ForEach<T>(this IEnumerable<T> source, Action<T> action)
    {
        foreach (var item in source)
            action(item);
    }

    // Случайный элемент
    public static T RandomElement<T>(this IList<T> list)
    {
        var rng = new Random();
        return list[rng.Next(list.Count)];
    }

    // Разделить на части (chunk) -- до C# 12 не было встроенного
    public static string JoinWith<T>(this IEnumerable<T> source, string separator)
    {
        return string.Join(separator, source);
    }

    // Безопасный доступ по индексу
    public static T? SafeGet<T>(this IList<T> list, int index)
    {
        if (index >= 0 && index < list.Count) return list[index];
        return default;
    }
}

// ForEach
Console.WriteLine("=== ForEach ===");
new[] { "Алиса", "Боб", "Чарли" }.ForEach(name => Console.WriteLine($"Привет, {name}!"));

// JoinWith
var csv = new[] { 1, 2, 3, 4, 5 }.JoinWith(", ");
Console.WriteLine($"CSV: {csv}");  // 1, 2, 3, 4, 5

// RandomElement
var colors = new List<string> { "красный", "синий", "зелёный", "жёлтый" };
Console.WriteLine($"Случайный цвет: {colors.RandomElement()}");

// SafeGet
var numbers = new List<int> { 10, 20, 30 };
Console.WriteLine($"Индекс 1: {numbers.SafeGet(1)}");   // 20
Console.WriteLine($"Индекс 99: {numbers.SafeGet(99)}");  // 0 (default для int)

