## 2. Расширения для числовых типов

Расширения работают для **любых типов** -- int, double, DateTime и т.д.:

```csharp
public static class IntExtensions
{
    public static bool IsEven(this int number) => number % 2 == 0;
    public static bool IsOdd(this int number) => number % 2 != 0;
    public static int Squared(this int number) => number * number;
}

// Использование
5.IsEven();    // false
5.IsOdd();     // true
5.Squared();   // 25
```

#!csharp

public static class NumberExtensions
{
    // Чётное?
    public static bool IsEven(this int n) => n % 2 == 0;

    // В диапазоне?
    public static bool IsBetween(this int n, int min, int max) => n >= min && n <= max;

    // Повторить действие N раз
    public static void Times(this int count, Action<int> action)
    {
        for (int i = 0; i < count; i++)
            action(i);
    }

    // Ограничить в диапазоне (clamp)
    public static double Clamp(this double value, double min, double max)
    {
        if (value < min) return min;
        if (value > max) return max;
        return value;
    }
}

Console.WriteLine($"4 чётное: {4.IsEven()}");           // true
Console.WriteLine($"7 чётное: {7.IsEven()}");           // false
Console.WriteLine($"5 в [1..10]: {5.IsBetween(1, 10)}"); // true
Console.WriteLine($"15 в [1..10]: {15.IsBetween(1, 10)}"); // false

// Повторить 3 раза
3.Times(i => Console.WriteLine($"Итерация {i}"));

// Clamp
Console.WriteLine($"150.0 clamp [0..100]: {150.0.Clamp(0, 100)}"); // 100
Console.WriteLine($"-5.0 clamp [0..100]: {(-5.0).Clamp(0, 100)}");  // 0

