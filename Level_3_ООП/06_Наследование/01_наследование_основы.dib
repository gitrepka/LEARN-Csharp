## 3. base -- обращение к базовому классу

Ключевое слово **`base`** позволяет обратиться к членам **базового класса** из производного:

- `base.Method()` -- вызвать метод базового класса
- `base.Property` -- обратиться к свойству базового класса
- `base(args)` -- вызвать конструктор базового класса

```csharp
class Animal
{
    public string Name { get; set; }
    public void Speak() => Console.WriteLine($"{Name} издаёт звук");
}

class Dog : Animal
{
    public void Speak()
    {
        base.Speak();  // Вызываем версию из Animal
        Console.WriteLine($"{Name} лает!");  // Добавляем своё
    }
}
```

#!csharp

public class Logger
{
    public string Prefix { get; set; }

    public void Log(string message)
    {
        Console.WriteLine($"[{Prefix}] {message}");
    }
}

public class TimestampLogger : Logger
{
    public void Log(string message)
    {
        // Дополняем базовую логику
        Console.Write($"{DateTime.Now:HH:mm:ss} ");
        base.Log(message);  // Вызываем Log из Logger
    }
}

public class ColorLogger : Logger
{
    public ConsoleColor Color { get; set; } = ConsoleColor.Green;

    public void Log(string message)
    {
        var oldColor = Console.ForegroundColor;
        Console.ForegroundColor = Color;
        base.Log(message);
        Console.ForegroundColor = oldColor;
    }
}

var logger = new TimestampLogger { Prefix = "APP" };
logger.Log("Приложение запущено");
logger.Log("Загрузка данных");

