## 4. Возврат кортежа из метода

Кортежи идеально подходят для методов, возвращающих **несколько значений**:

```csharp
// Метод возвращает кортеж
(int Quotient, int Remainder) Divide(int a, int b)
{
    return (a / b, a % b);
}

var result = Divide(17, 5);
Console.WriteLine($"17 / 5 = {result.Quotient}, остаток {result.Remainder}");

// Или сразу деконструкция
var (q, r) = Divide(17, 5);
```

#!csharp

// Метод возвращает минимум и максимум массива
(int Min, int Max) FindMinMax(int[] numbers)
{
    int min = numbers[0];
    int max = numbers[0];
    foreach (var n in numbers)
    {
        if (n < min) min = n;
        if (n > max) max = n;
    }
    return (min, max);
}

int[] data = { 5, 2, 8, 1, 9, 3, 7 };
var (min, max) = FindMinMax(data);
Console.WriteLine($"Мин: {min}, Макс: {max}");  // Мин: 1, Макс: 9

// Ещё пример: статистика строки
(int Words, int Chars, int Spaces) AnalyzeText(string text)
{
    int words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
    int chars = text.Length;
    int spaces = text.Count(c => c == ' ');
    return (words, chars, spaces);
}

var (words, chars, spaces) = AnalyzeText("Привет мир, это C#!");
Console.WriteLine($"Слов: {words}, символов: {chars}, пробелов: {spaces}");

