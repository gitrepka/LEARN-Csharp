## 2. CompareTo() -- сложная сортировка

Можно реализовать сортировку по **нескольким критериям**:

```csharp
public int CompareTo(Student? other)
{
    // Сначала по GPA (по убыванию)
    int result = other.GPA.CompareTo(this.GPA);  // Обратный порядок!

    // Если GPA одинаковый -- по имени (по алфавиту)
    if (result == 0)
        result = string.Compare(Name, other.Name, StringComparison.Ordinal);

    return result;
}
```

#!csharp

public class Employee : IComparable<Employee>
{
    public string Name { get; set; }
    public string Department { get; set; }
    public int Salary { get; set; }

    public Employee(string name, string dept, int salary)
    {
        Name = name;
        Department = dept;
        Salary = salary;
    }

    // Сортировка: сначала по отделу, потом по зарплате (по убыванию), потом по имени
    public int CompareTo(Employee? other)
    {
        if (other is null) return 1;

        // 1. По отделу
        int result = string.Compare(Department, other.Department, StringComparison.Ordinal);
        if (result != 0) return result;

        // 2. По зарплате (по убыванию -- обратный порядок!)
        result = other.Salary.CompareTo(Salary);
        if (result != 0) return result;

        // 3. По имени
        return string.Compare(Name, other.Name, StringComparison.Ordinal);
    }

    public override string ToString() => $"{Department,-10} {Name,-15} {Salary,10:N0} руб.";
}

var employees = new List<Employee>
{
    new("Алиса", "IT", 150000),
    new("Боб", "HR", 120000),
    new("Чарли", "IT", 180000),
    new("Диана", "HR", 120000),
    new("Евгений", "IT", 150000),
};

employees.Sort();

Console.WriteLine("Отсортированные сотрудники:");
Console.WriteLine($"{"Отдел",-10} {"Имя",-15} {"Зарплата",10}");
Console.WriteLine(new string('-', 37));
employees.ForEach(e => Console.WriteLine(e));

