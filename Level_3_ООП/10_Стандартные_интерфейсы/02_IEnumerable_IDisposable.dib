## 6. yield break и продвинутые итераторы

**`yield break`** -- досрочно завершает итератор:

```csharp
IEnumerable<int> TakeWhilePositive(int[] numbers)
{
    foreach (var n in numbers)
    {
        if (n < 0) yield break;  // Стоп! Дальше не генерируем
        yield return n;
    }
}
```

#!csharp

// yield break -- досрочная остановка
IEnumerable<int> TakeUntilZero(int[] numbers)
{
    foreach (var n in numbers)
    {
        if (n == 0) yield break;
        yield return n;
    }
}

var data = new[] { 5, 3, 8, 0, 2, 7 };
Console.WriteLine($"До нуля: {string.Join(", ", TakeUntilZero(data))}");
// 5, 3, 8

// Генератор диапазонов
IEnumerable<(int Start, int End)> Chunks(int total, int chunkSize)
{
    for (int i = 0; i < total; i += chunkSize)
    {
        yield return (i, Math.Min(i + chunkSize - 1, total - 1));
    }
}

Console.WriteLine("\nРазбиение 25 на части по 7:");
foreach (var (start, end) in Chunks(25, 7))
    Console.WriteLine($"  [{start}..{end}]");

// Генератор случайных данных
IEnumerable<string> RandomNames(int count)
{
    var names = new[] { "Алиса", "Боб", "Чарли", "Диана", "Евгений" };
    var rng = new Random(42);

    for (int i = 0; i < count; i++)
    {
        yield return names[rng.Next(names.Length)];
    }
}

Console.WriteLine($"\n5 случайных имён: {string.Join(", ", RandomNames(5))}");

// Цепочка итераторов
IEnumerable<T> Interleave<T>(IEnumerable<T> a, IEnumerable<T> b)
{
    using var ea = a.GetEnumerator();
    using var eb = b.GetEnumerator();

    while (true)
    {
        bool hasA = ea.MoveNext();
        bool hasB = eb.MoveNext();

        if (hasA) yield return ea.Current;
        if (hasB) yield return eb.Current;

        if (!hasA && !hasB) yield break;
    }
}

var odds = new[] { 1, 3, 5, 7 };
var evens = new[] { 2, 4, 6 };
Console.WriteLine($"\nЧередование: {string.Join(", ", Interleave(odds, evens))}");

