## 2. Множественная реализация интерфейсов

Класс может реализовать **несколько** интерфейсов (в отличие от наследования, где только один базовый класс):

```csharp
public interface IMovable { void Move(); }
public interface IAttackable { void Attack(); }
public interface IHealable { void Heal(); }

// Класс реализует ТРИ интерфейса!
public class Paladin : IMovable, IAttackable, IHealable
{
    public void Move() => Console.WriteLine("Паладин идёт");
    public void Attack() => Console.WriteLine("Паладин атакует");
    public void Heal() => Console.WriteLine("Паладин лечит");
}
```

#!csharp

public interface IPrintable
{
    void Print();
}

public interface ISaveable
{
    void Save(string path);
    bool IsSaved { get; }
}

public interface IExportable
{
    string Export(string format);
}

// Класс реализует ВСЕ ТРИ интерфейса
public class Document : IPrintable, ISaveable, IExportable
{
    public string Title { get; set; }
    public string Content { get; set; }
    public bool IsSaved { get; private set; }

    public Document(string title, string content)
    {
        Title = title;
        Content = content;
    }

    public void Print()
        => Console.WriteLine($"Печать: {Title}\n{Content}");

    public void Save(string path)
    {
        Console.WriteLine($"Сохранение {Title} в {path}");
        IsSaved = true;
    }

    public string Export(string format)
    {
        return format.ToLower() switch
        {
            "txt" => Content,
            "html" => $"<h1>{Title}</h1><p>{Content}</p>",
            "md" => $"# {Title}\n\n{Content}",
            _ => throw new ArgumentException($"Неизвестный формат: {format}")
        };
    }
}

var doc = new Document("Отчёт", "Продажи выросли на 20%");

// Используем через разные интерфейсы
IPrintable printable = doc;
printable.Print();

ISaveable saveable = doc;
saveable.Save("/docs/report.txt");
Console.WriteLine($"Сохранён: {saveable.IsSaved}");

IExportable exportable = doc;
Console.WriteLine($"\nHTML: {exportable.Export("html")}");
Console.WriteLine($"Markdown: {exportable.Export("md")}");

