## 4. Цепочка конструкторов -- this()

Когда у класса **несколько конструкторов**, один может вызывать другой через **`this()`**:

```csharp
public class Rectangle
{
    public double Width { get; }
    public double Height { get; }

    // Основной конструктор
    public Rectangle(double width, double height)
    {
        Width = width;
        Height = height;
    }

    // Вызывает основной -- квадрат
    public Rectangle(double side) : this(side, side) { }

    // Вызывает основной -- по умолчанию
    public Rectangle() : this(1, 1) { }
}
```

`this(...)` вызывается **до** тела конструктора. Это позволяет избежать дублирования кода.

#!csharp

public class ConnectionString
{
    public string Host { get; }
    public int Port { get; }
    public string Database { get; }
    public string User { get; }
    public string Password { get; }

    // Полный конструктор
    public ConnectionString(string host, int port, string database, string user, string password)
    {
        Host = host;
        Port = port;
        Database = database;
        User = user;
        Password = password;
        Console.WriteLine($"  [Полный конструктор] {this}");
    }

    // Без пароля -- вызывает полный
    public ConnectionString(string host, int port, string database, string user)
        : this(host, port, database, user, "") { }

    // Только хост и БД -- дефолтные порт и пользователь
    public ConnectionString(string host, string database)
        : this(host, 5432, database, "postgres", "") { }

    // Localhost
    public ConnectionString(string database)
        : this("localhost", database) { }

    public override string ToString()
        => $"Host={Host};Port={Port};DB={Database};User={User}";
}

Console.WriteLine("Создание через разные конструкторы:");
var c1 = new ConnectionString("mydb");
var c2 = new ConnectionString("server.com", "production");
var c3 = new ConnectionString("server.com", 3306, "mydb", "admin", "secret");

